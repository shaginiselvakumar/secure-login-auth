{
  "name": "secure-login",
  "version": "1.0.0",
  "description": "Production-ready secure login system with MFA, rate limiting, CSRF protection, and audit logging",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "set NODE_ENV=development& nodemon server/index.js",
    "test": "jest --coverage",
    "test:server": "node test-server.js",
    "lint": "eslint server/ --ext .js",
    "check": "node check-setup.js",
    "setup": "node check-setup.js && npm install",
    "setup:email": "node setup-email.js"
  },
  "dependencies": {
    "argon2": "^0.40.3",
    "bcrypt": "^5.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "mongoose": "^9.4.1",
    "nodemailer": "^8.0.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "optionalDependencies": {
    "@simplewebauthn/server": "^9.0.0",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.10"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
